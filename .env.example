# Copy to .env and fill in real values before running anything.

# --- Database (docker-compose defaults shown) ---
DATABASE_URL="postgresql://ailm:ailm_dev_password@localhost:5432/ai_life_manager?schema=public"

# --- Auth (Clerk) ---
# Create a free Clerk application at https://dashboard.clerk.com to get real values.
CLERK_SECRET_KEY="sk_test_replace_me"
CLERK_PUBLISHABLE_KEY="pk_test_replace_me"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_replace_me"

# --- Local development only ---
# When AUTH_MODE=dev, the backend accepts an `x-dev-user-email` header instead of a
# verified Clerk session token, and the web app injects that header automatically.
# This path is hard-disabled whenever NODE_ENV=production (see auth/dev-auth.guard.ts).
# Real deployments must set AUTH_MODE=clerk.
AUTH_MODE="dev"
NEXT_PUBLIC_AUTH_MODE="dev"

PORT=4000
NODE_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:4000/graphql"
FRONTEND_URL="http://localhost:3000"

# --- Google Calendar sync (optional — leave blank until you want it) ---
# Create credentials at https://console.cloud.google.com (enable the Google
# Calendar API, create an OAuth client ID of type "Web application", add
# GOOGLE_REDIRECT_URI below as an authorized redirect URI). All five of these
# are required together, or leave all five blank to keep the feature off —
# the app boots fine either way.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/auth/google/callback"
# Any passphrase-shaped string — encrypts stored Google tokens at rest.
TOKEN_ENCRYPTION_KEY=""
# Any passphrase-shaped string — signs the OAuth redirect's state param.
OAUTH_STATE_SECRET=""

# --- Microsoft (Outlook/365) calendar sync (optional — leave blank until you want it) ---
# Register an app at https://portal.azure.com (Azure Active Directory >
# App registrations > New registration). Add MICROSOFT_REDIRECT_URI below as
# a "Web" platform redirect URI, and under "Certificates & secrets" create a
# client secret. All three of these are required together, or leave all
# three blank to keep the feature off — the app boots fine either way.
# Reuses TOKEN_ENCRYPTION_KEY / OAUTH_STATE_SECRET above (same generic
# secrets Google sync uses) rather than needing their own.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_REDIRECT_URI="http://localhost:4000/auth/microsoft/callback"

# --- AI daily planning (optional — leave blank until you want it) ---
# Create a key at https://console.anthropic.com (API Keys section). Leave
# blank to keep the feature off — the app boots fine either way, and the
# "Generate my plan" button will show a clear message instead of crashing.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Real notification delivery: web push (optional — leave blank until you want it) ---
# Generate your own pair with `npx web-push generate-vapid-keys` (run from
# apps/backend). Leave both blank to keep push delivery off — the app boots
# fine either way, and WebPushService just no-ops. The frontend does NOT
# need its own NEXT_PUBLIC_ copy of the public key — it fetches it live via
# the `vapidPublicKey` GraphQL query instead.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@example.com"

# --- Native app shell: Firebase Cloud Messaging (optional — leave blank
# until you want it) ---
# Only relevant once a native app (apps/mobile) is actually being used —
# Android's WebView has no Web Push API at all, so browser push
# (VAPID_* above) can never reach it; FCM is the real, OS-level
# equivalent. Get this from Firebase Console → Project Settings → Service
# accounts → Generate new private key, then base64-encode the whole
# downloaded JSON file (e.g. `base64 -i service-account.json`) into this one
# var — Railway (this app's host) has no per-service file mount, only env
# vars. Leave blank to keep native push delivery off — the app boots fine
# either way, and NativePushService just no-ops.
FIREBASE_SERVICE_ACCOUNT_BASE64=""

# --- Real notification delivery: email (optional — leave blank until you want it) ---
# Create a free account at https://resend.com and generate an API key. Leave
# blank to keep email delivery off — EmailService just no-ops.
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="AI Life Manager <notifications@example.com>"

# --- SMS delivery (optional — leave blank until you want it) ---
# Create a free trial account at https://www.twilio.com, grab your Account
# SID and Auth Token from the console dashboard, and buy/verify a phone
# number for TWILIO_FROM_NUMBER (E.164 format, e.g. +15551234567). Also set
# a phone number for yourself on /notifications — the SMS checkbox there
# does nothing without one. Leave all three blank to keep SMS delivery off —
# SmsService just no-ops.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- Real Stripe billing (optional — leave blank until you want it) ---
# Create a free Stripe account at https://dashboard.stripe.com (test mode is
# fine to start). Create two recurring Prices under Products (Plus, Pro) and
# copy their Price ids below. Create a webhook endpoint pointing at
# <your backend URL>/webhooks/stripe, subscribed to at least
# checkout.session.completed, customer.subscription.updated, and
# customer.subscription.deleted, and copy its signing secret below. For local
# development, `stripe listen --forward-to localhost:4000/webhooks/stripe`
# (Stripe CLI) prints a webhook secret you can use instead of a real
# dashboard endpoint. Also enable "Customer update" for Price switching in
# the Billing Portal's own settings (Settings > Billing > Customer portal) if
# you want Manage billing to allow changing between Plus/Pro, not just
# canceling. All four of these are required together, or leave all four
# blank to keep the feature off — the app boots fine either way, and Settings
# falls back to a simulated instant plan switch instead.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PLUS=""
STRIPE_PRICE_ID_PRO=""
