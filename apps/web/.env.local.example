# Copy to .env.local before running `npm run dev` in this directory.

NEXT_PUBLIC_API_URL="http://localhost:4000/graphql"

# --- Auth ---
# Matches the backend's AUTH_MODE — see the root .env.example for context.
NEXT_PUBLIC_AUTH_MODE="dev"
NEXT_PUBLIC_DEV_USER_EMAIL="you@example.com"

# Required once NEXT_PUBLIC_AUTH_MODE=clerk:
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_replace_me"
